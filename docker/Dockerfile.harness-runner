# Containerized Adversarial Testing Harness Runner
# Provides a self-contained execution environment with Python 3.12, Node.js 22,
# Promptfoo, PyRIT, Garak, RAMPART, Inspect AI, and DeepTeam.
# Eliminates all host dependencies.

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    IN_CONTAINER=1 \
    PROMPTFOO_DISABLE_TELEMETRY=true \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/root/.cargo/bin:${PATH}"

# Install baseline OS utilities, Git, SQLite, and Node.js 22.x
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    sqlite3 \
    ca-certificates \
    gnupg \
    pkg-config \
    libssl-dev \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g promptfoo@latest \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install Python requirements (using rustup for pyrit's base2048 dependency)
COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir pydantic pyyaml httpx pytest pytest-asyncio \
    && rm -rf /root/.cargo /root/.rustup

# Default execution runs all harnesses in parallel against containerized targets
ENTRYPOINT ["/bin/bash"]
CMD ["./scripts/run_all_harnesses.sh", "--parallel", "--skip-docker"]
